ANTHROPIC_API_KEY=
# Leave ANTHROPIC_BASE_URL empty to call the real Anthropic API.
# To route through a company Open WebUI instance instead (e.g. to reach a
# local/self-hosted model via its Anthropic-Messages-compatible proxy):
#   - ANTHROPIC_BASE_URL must be the Open WebUI *api* root, no /v1 suffix
#     (the Anthropic SDK appends /v1/messages itself), e.g.:
#       ANTHROPIC_BASE_URL=http://openwebui.internal:3000/api
#   - ANTHROPIC_API_KEY becomes the Open WebUI API key (Settings > Account),
#     sent as the x-api-key header, which Open WebUI accepts.
#   - MODEL_PLANNER/MODEL_SYNTHESIZER/MODEL_CRITIC/MODEL_INTENT below must
#     then be model IDs as they appear in Open WebUI (e.g. "qwen3.6:27b"),
#     not Claude model names -- Open WebUI resolves "model" itself and
#     ignores an id it doesn't recognize.
ANTHROPIC_BASE_URL=
MARKET_DATA_PROVIDER=yfinance
POLYGON_API_KEY=
# Ports match docker-compose.yml's host-side remap (this machine already runs other
# Postgres/Redis containers on 5432/6379) - use 5432/6379 here if yours doesn't conflict.
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:55432/quantagent
# 127.0.0.1, not localhost: on Windows + Docker Desktop, "localhost" can
# resolve to the IPv6 loopback (::1) first, which Docker Desktop's port
# forwarding doesn't listen on -- redis-py then hangs until its own timeout
# instead of falling back to IPv4 quickly (asyncpg/Postgres above happens to
# tolerate this fine, redis-py does not). Pin the IPv4 literal to avoid it.
REDIS_URL=redis://127.0.0.1:56379/0
SEC_USER_AGENT="YourName your@email.com"
MODEL_PLANNER=claude-sonnet-4-6
MODEL_SYNTHESIZER=claude-sonnet-4-6
MODEL_CRITIC=claude-sonnet-4-6
MODEL_INTENT=claude-haiku-4-5
MAX_TOOL_CALLS=12
MAX_WALL_MS=12000
MAX_USD_PER_REQUEST=0.15
LOG_LEVEL=INFO
ENV=local
